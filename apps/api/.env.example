ASK_LUCAS_BUILD_VERSION=local
ASK_LUCAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ASK_LUCAS_CONTENT_DIR=../../examples/content
ASK_LUCAS_ANSWER_FIXTURE_PATH=../../examples/fixtures/answers.json
ASK_LUCAS_EVALUATION_PATH=../../examples/evals/employer-questions.yaml
ASK_LUCAS_INDEX_PATH=data/content.db
ASK_LUCAS_RUNTIME_DB_PATH=data/runtime.db
ASK_LUCAS_PROVIDER=auto
ASK_LUCAS_ANTHROPIC_MODEL=claude-haiku-4-5
# ASK_LUCAS_ANTHROPIC_API_KEY=store-this-outside-git
ASK_LUCAS_ANTHROPIC_TIMEOUT_SECONDS=30
ASK_LUCAS_RATE_LIMIT_REQUESTS=12
ASK_LUCAS_RATE_LIMIT_WINDOW_SECONDS=60
ASK_LUCAS_MAX_CONCURRENT_GENERATIONS=2
ASK_LUCAS_DAILY_LIVE_GENERATION_LIMIT=100
ASK_LUCAS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
