ASK_LUCAS_PRIVATE_ROOT=/opt/ask-lucas/private
ASK_LUCAS_BUILD_VERSION=local
ASK_LUCAS_ALLOWED_ORIGINS=https://ask.lkmori.com
ASK_LUCAS_PROVIDER=auto
ASK_LUCAS_ANTHROPIC_MODEL=claude-haiku-4-5
# ASK_LUCAS_ANTHROPIC_API_KEY=store-this-only-on-the-vps
ASK_LUCAS_RATE_LIMIT_REQUESTS=12
ASK_LUCAS_RATE_LIMIT_WINDOW_SECONDS=60
ASK_LUCAS_MAX_CONCURRENT_GENERATIONS=2
ASK_LUCAS_DAILY_LIVE_GENERATION_LIMIT=100
ASK_LUCAS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
